{
  "realm": "qa-platform",
  "enabled": true,
  "displayName": "QA Platform (dev)",
  "attributes": {
    "x-qa-platform-provenance": "REDUCED KEYCLOAK REALM EXPORT (26.0.8), not hand-written. Configured via kcadm.sh, exported with `kc.sh export --users same_file`, then stripped of every key that only restated a Keycloak default -- notably components['org.keycloak.keys.KeyProvider'], which would have committed the realm's private signing key. Do not paste it back.",
    "x-qa-platform-docs": "Full rationale lives in the `keycloak` service comment in gears/qa-platform/deploy/compose/docker-compose.yml. This file cannot carry JSON comments: an unrecognised top-level key such as `_comment` aborts import with 'Unrecognized field ... RealmRepresentation, not marked as ignorable'. This `attributes` map is the one place a note fits.",
    "x-qa-platform-tenant-claim": "The tenant-id protocol mapper must emit a UUID: oidc-authn-plugin parses it with Uuid::parse_str. The value is toolkit_security::constants::DEFAULT_TENANT_ID, which owns every row created while auth_disabled was true. Changing it hides that data silently rather than erroring.",
    "x-qa-platform-dev-only": "DEV FIXTURE. Passwords are in this file and directAccessGrantsEnabled is on so the compose gates can get a token without a browser. Not a template for a real deployment."
  },
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "qa-platform-ui",
      "name": "QA Platform UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "qa-platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "qa-platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    },
    {
      "clientId": "qa-platform-workflow",
      "name": "QA Platform Workflow Runner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "secret": "qa-platform-workflow-dev-secret",
      "protocolMappers": [
        {
          "name": "qa-platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "qa-platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "00000000-df51-5b42-9538-d2b56b7ee953",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "access.tokenResponse.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@qa-platform.local",
      "emailVerified": true,
      "firstName": "admin",
      "lastName": "user",
      "attributes": {
        "tenant_id": [
          "00000000-df51-5b42-9538-d2b56b7ee953"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-qa-platform"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@qa-platform.local",
      "emailVerified": true,
      "firstName": "viewer",
      "lastName": "user",
      "attributes": {
        "tenant_id": [
          "00000000-df51-5b42-9538-d2b56b7ee953"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-qa-platform"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant ID\",\"validations\":{\"length\":{\"min\":36,\"max\":36}},\"annotations\":{},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
